---
import { SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p class="meta">© {year} <a href={SITE.authorUrl} target="_blank" rel="noopener">{SITE.author}</a> · <a href="/about">关于</a> · <a href="/rss.xml">RSS</a></p>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-24);
    border-top: 1px solid var(--c-line);
    padding: var(--s-8) var(--s-6);
    text-align: center;
  }
  .site-footer p {
    margin: 0;
    font-size: var(--fs-small);
  }
</style>
