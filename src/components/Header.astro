---
import StarTree from './StarTree.astro';
import { SITE } from '../consts';
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="brand" aria-label={`${SITE.title} 首页`}>
      <StarTree size={24} />
      <span>{SITE.title}</span>
    </a>
    <nav class="nav" aria-label="外部链接">
      <a href={SITE.repoUrl} target="_blank" rel="noopener" aria-label="GitHub 仓库">
        <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
      </a>
      <a href={SITE.xUrl} target="_blank" rel="noopener" aria-label="X">
        <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
          <path
            d="M9.52 6.77 15.48 0h-1.41L8.9 5.88 4.76 0H0l6.25 8.9L0 16h1.41l5.46-6.2L11.24 16H16L9.52 6.77zM7.58 8.98l-.63-.89L1.92 1.04h2.17l4.06 5.68.63.89 5.28 7.39h-2.17L7.58 8.98z"
          ></path>
        </svg>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--c-line);
    background: var(--c-canvas);
  }
  .site-header__inner {
    max-width: var(--w-wide);
    margin-inline: auto;
    padding: var(--s-3) var(--s-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--c-ink);
    text-decoration: none;
    font-size: 1.05rem;
    font-weight: 500;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }
  .nav a {
    display: inline-flex;
    color: var(--c-ink-faint);
  }
  .nav a:hover {
    color: var(--c-ink);
  }
</style>
