---
import { FILM_TYPE, type FilmType } from '../consts';

interface Film {
  title: string;
  director: string;
  poster: string;
  type: FilmType;
  note: string;
}
interface Props {
  films: { id: string; data: Film }[];
}
const { films } = Astro.props;

const groups = FILM_TYPE.map((t) => ({
  ...t,
  items: films.filter((f) => f.data.type === t.id),
})).filter((g) => g.items.length > 0);
---

<div class="shelf stack" data-shelf>
  {
    groups.map((g) => (
      <section data-type={g.id}>
        <h2 class="shelf__heading">
          {g.name}
          <span class="meta">（{g.items.length}）</span>
        </h2>
        <ul class="shelf__grid">
          {g.items.map((f) => (
            <li class="book">
              <div class="book__cover">
                <img src={f.data.poster} alt={`《${f.data.title}》海报`} loading="lazy" />
              </div>
              <div class="book__body">
                <p class="book__title">{f.data.title}</p>
                <p class="meta">{f.data.director}</p>
                <p class="book__note">{f.data.note}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .shelf__heading {
    font-size: var(--fs-h3);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--c-line);
  }
  .shelf__grid {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--s-8) var(--s-5);
  }
  .book {
    position: relative;
    transition: transform 0.25s ease;
  }
  .book:hover {
    z-index: 2;
  }
  .book__cover {
    display: block;
    aspect-ratio: 2 / 3;
    background: var(--c-sand);
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-float);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .book:hover .book__cover {
    transform: scale(1.03);
    box-shadow: 0 10px 24px rgba(251, 114, 153, 0.28);
  }
  .book__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .book__title {
    margin: var(--s-3) 0 0;
    font-weight: 700;
    line-height: var(--lh-snug);
  }
  .book .meta {
    margin: 2px 0 0;
  }
  .book__note {
    margin: var(--s-2) 0 0;
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
    line-height: var(--lh-snug);
  }

  /* 列表视图 */
  [data-shelf].is-list .shelf__grid {
    display: block;
  }
  [data-shelf].is-list .book {
    display: grid;
    grid-template-columns: 40px 1fr;
    column-gap: var(--s-4);
    align-items: start;
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--c-line);
  }
  [data-shelf].is-list .book__cover,
  [data-shelf].is-list .book:hover .book__cover {
    box-shadow: none;
    transform: none;
  }
  [data-shelf].is-list .book__title {
    margin: 0;
  }
  [data-shelf].is-list .book__note {
    margin: var(--s-1) 0 0;
  }
</style>
