---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookShelf from '../components/BookShelf.astro';
import { BOOK_BOT } from '../consts';
import xiaoshuAvatar from '../assets/xiaoshu-avatar.jpg';

const books = await getCollection('books');

const counts = { reading: 0, read: 0, want: 0 };
for (const b of books) counts[b.data.status]++;
---

<BaseLayout title="书籍" description="星树浩的书架：在读、读完、想读，每本一句话。">
  <div class="page page--wide stack">
    <header>
      <h1>书籍</h1>
      <p class="meta">在读 · 读完 · 想读，每本一句话</p>
    </header>

    <section class="resources">
      <p class="resources__lead">电子书按书名或作者搜，三个渠道：</p>

      <div class="resources__row">
        <a class="src" href="https://annas-archive.cc" target="_blank" rel="noopener">Anna's Archive</a>
        <a class="src" href="https://z-library.bz" target="_blank" rel="noopener">Z-Library</a>
        <span class="meta">世界上最大的 2 个免费图书馆</span>
      </div>

      <div class="resources__row">
        <Image
          class="bot-avatar"
          src={xiaoshuAvatar}
          alt={`${BOOK_BOT.name}（Telegram bot）头像`}
          width={88}
          height={88}
          loading="lazy"
        />
        <a class="btn" href={BOOK_BOT.url} target="_blank" rel="noopener">
          Telegram bot {BOOK_BOT.name} ↗
        </a>
        <span class="meta">{BOOK_BOT.hint}</span>
      </div>
    </section>

    <div class="shelf-bar" hidden>
      <div class="shelf-menu-wrap">
        <button
          type="button"
          class="shelf-menu-toggle"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M2 4h9M2 8h6M2 12h3" />
            <circle cx="13" cy="4" r="1.6" fill="currentColor" stroke="none" />
            <circle cx="10" cy="8" r="1.6" fill="currentColor" stroke="none" />
            <circle cx="7" cy="12" r="1.6" fill="currentColor" stroke="none" />
          </svg>
          <span class="shelf-menu-label">网格 · 全部</span>
        </button>
        <div class="shelf-menu" role="menu" hidden>
          <p class="shelf-menu__group">排列</p>
          <button type="button" role="menuitemradio" data-view="grid" aria-checked="true">网格</button>
          <button type="button" role="menuitemradio" data-view="list" aria-checked="false">列表</button>
          <hr />
          <p class="shelf-menu__group">阅读状态</p>
          <button type="button" role="menuitemradio" data-status="all" aria-checked="true">全部</button>
          {counts.reading > 0 && <button type="button" role="menuitemradio" data-status="reading" aria-checked="false">在读</button>}
          {counts.read > 0 && <button type="button" role="menuitemradio" data-status="read" aria-checked="false">读完</button>}
          {counts.want > 0 && <button type="button" role="menuitemradio" data-status="want" aria-checked="false">想读</button>}
        </div>
      </div>
    </div>

    <div data-pagefind-body>
      <BookShelf books={books} />
    </div>
  </div>
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>('.shelf-bar');
  const shelf = document.querySelector<HTMLElement>('[data-shelf]');
  if (bar && shelf) {
    bar.hidden = false;

    const toggle = bar.querySelector<HTMLElement>('.shelf-menu-toggle')!;
    const menu = bar.querySelector<HTMLElement>('.shelf-menu')!;
    const label = bar.querySelector<HTMLElement>('.shelf-menu-label')!;
    const items = [...menu.querySelectorAll<HTMLElement>('button[role="menuitemradio"]')];
    const sections = [...shelf.querySelectorAll<HTMLElement>('section[data-status]')];

    const VIEW_NAME: Record<string, string> = { grid: '网格', list: '列表' };
    const STATUS_NAME: Record<string, string> = {
      all: '全部',
      reading: '在读',
      read: '读完',
      want: '想读',
    };

    const KEY = 'hoshiki:books-view';
    const state = { status: 'all', view: 'grid' };
    try {
      Object.assign(state, JSON.parse(localStorage.getItem(KEY) || '{}'));
    } catch {}
    // 所选状态若已无书（书单变动），回退「全部」
    if (state.status !== 'all' && !items.some((b) => b.dataset.status === state.status)) {
      state.status = 'all';
    }

    function apply() {
      shelf.classList.toggle('is-list', state.view === 'list');
      for (const sec of sections) {
        sec.hidden = state.status !== 'all' && sec.dataset.status !== state.status;
      }
      for (const b of items) {
        const on = b.dataset.view === state.view || b.dataset.status === state.status;
        b.setAttribute('aria-checked', String(on));
      }
      label.textContent = `${VIEW_NAME[state.view]} · ${STATUS_NAME[state.status]}`;
    }

    function openMenu() {
      menu.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
    }
    function closeMenu() {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    }

    toggle.addEventListener('click', () => {
      menu.hidden ? openMenu() : closeMenu();
    });
    menu.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('button');
      if (!btn) return;
      if (btn.dataset.view) state.view = btn.dataset.view;
      if (btn.dataset.status) state.status = btn.dataset.status;
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch {}
      apply();
    });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !bar.contains(e.target as Node)) closeMenu();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        closeMenu();
        toggle.focus();
      }
    });

    apply();
  }
</script>

<style>
  .resources {
    padding: var(--s-6);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .resources__lead {
    margin: 0;
    color: var(--c-ink-soft);
  }
  .resources__row {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
  .src {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--c-accent);
    color: #fff;
    text-decoration: none;
    font-size: 0.95em;
  }
  .src:hover {
    background: var(--c-ink);
  }
  .bot-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--c-line);
    flex-shrink: 0;
  }

  .shelf-bar {
    display: flex;
    justify-content: flex-end;
  }
  .shelf-menu-wrap {
    position: relative;
  }
  .shelf-menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-sm);
    color: var(--c-ink-soft);
    font-family: inherit;
    font-size: var(--fs-small);
    cursor: pointer;
  }
  .shelf-menu-toggle:hover {
    border-color: var(--c-accent);
  }

  .shelf-menu {
    position: absolute;
    right: 0;
    top: calc(100% + var(--s-2));
    z-index: 10;
    min-width: 9rem;
    padding: var(--s-2);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-float);
  }
  .shelf-menu__group {
    margin: var(--s-2) var(--s-2) var(--s-1);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    color: var(--c-ink-faint);
  }
  .shelf-menu hr {
    margin: var(--s-2) 0;
    border: 0;
    border-top: 1px solid var(--c-line);
  }
  .shelf-menu button {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    width: 100%;
    padding: var(--s-2);
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--c-ink);
    font-family: inherit;
    font-size: var(--fs-small);
    text-align: left;
    cursor: pointer;
  }
  .shelf-menu button::before {
    content: '';
    width: 1em;
    flex-shrink: 0;
    color: var(--c-accent);
  }
  .shelf-menu button[aria-checked='true']::before {
    content: '✓';
  }
  .shelf-menu button:hover {
    background: var(--c-accent-weak);
  }
</style>
