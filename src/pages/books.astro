---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookShelf from '../components/BookShelf.astro';
import { BOOK_BOT } from '../consts';
import xiaoshuAvatar from '../assets/xiaoshu-avatar.jpg';

const books = await getCollection('books');
---

<BaseLayout title="书籍" description="星树浩的书架：在读、读完、想读，每本一句话。">
  <div class="page page--wide stack">
    <header>
      <h1>书籍</h1>
      <p class="meta">在读 · 读完 · 想读，每本一句话</p>
    </header>

    <section class="resources">
      <p>
        想找电子版：<strong>安娜的档案</strong>（Anna's Archive）和
        <strong>Z-Library</strong> 是两个常用的聚合搜索站，按书名或 ISBN 搜，大多数书都能找到。
      </p>
      <p>找不到的，在 Telegram 上把书名发给「{BOOK_BOT.name}」，从我的库里找。</p>
      <p class="bot-row">
        <Image
          class="bot-avatar"
          src={xiaoshuAvatar}
          alt={`${BOOK_BOT.name}（Telegram bot）头像`}
          width={88}
          height={88}
          loading="lazy"
        />
        <a class="btn" href={BOOK_BOT.url} target="_blank" rel="noopener">
          在 Telegram 找{BOOK_BOT.name} ↗
        </a>
        <span class="meta">{BOOK_BOT.hint}</span>
      </p>
    </section>

    <div data-pagefind-body>
      <BookShelf books={books} />
    </div>
  </div>
</BaseLayout>

<style>
  .resources {
    padding: var(--s-6);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-sm);
  }
  .resources p {
    margin: 0 0 var(--s-3);
  }
  .resources p:last-child {
    margin-bottom: 0;
  }
  .bot-row {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
  .bot-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--c-line);
    flex-shrink: 0;
  }
</style>
