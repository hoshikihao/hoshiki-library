---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookShelf from '../components/BookShelf.astro';
import { BOOK_BOT } from '../consts';

const books = await getCollection('books');

const counts = { reading: 0, read: 0, want: 0 };
for (const b of books) counts[b.data.status]++;
---

<BaseLayout
  title="书林"
  description="星树浩的书架：在读、读完、想读，每本一句话。"
  bodyClass="readwise-books"
  ogImage="/og-books.png"
>
  <div class="page page--wide stack">
    <header>
      <h1>书林</h1>
      <div class="platforms">
        <a class="src" href="https://annas-archive.cc" target="_blank" rel="noopener">
          <Icon name="lucide:archive" width={15} height={15} />
          Anna's Archive
        </a>
        <a class="src" href="https://z-library.bz" target="_blank" rel="noopener">
          <Icon name="lucide:library" width={15} height={15} />
          Z-Library
        </a>
        <a class="src" href={BOOK_BOT.url} target="_blank" rel="noopener">
          <Icon name="simple-icons:telegram" width={15} height={15} />
          {BOOK_BOT.name}
        </a>
      </div>
    </header>

    <div class="shelf-bar" hidden>
      <div class="shelf-menu-wrap">
        <button
          type="button"
          class="shelf-menu-toggle"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <Icon name="lucide:sliders-horizontal" width={14} height={14} />
          <span class="shelf-menu-label">网格 · 全部</span>
        </button>
        <div class="shelf-menu" role="menu" hidden>
          <p class="shelf-menu__group">排列</p>
          <button type="button" role="menuitemradio" data-view="grid" aria-checked="true">网格</button>
          <button type="button" role="menuitemradio" data-view="list" aria-checked="false">列表</button>
          <hr />
          <p class="shelf-menu__group">阅读状态</p>
          <button type="button" role="menuitemradio" data-status="all" aria-checked="true">全部</button>
          {counts.reading > 0 && <button type="button" role="menuitemradio" data-status="reading" aria-checked="false">在读</button>}
          {counts.read > 0 && <button type="button" role="menuitemradio" data-status="read" aria-checked="false">读完</button>}
          {counts.want > 0 && <button type="button" role="menuitemradio" data-status="want" aria-checked="false">想读</button>}
        </div>
      </div>
    </div>

    <div data-pagefind-body>
      <BookShelf books={books} />
    </div>
  </div>
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>('.shelf-bar');
  const shelf = document.querySelector<HTMLElement>('[data-shelf]');
  if (bar && shelf) {
    bar.hidden = false;

    const toggle = bar.querySelector<HTMLElement>('.shelf-menu-toggle')!;
    const menu = bar.querySelector<HTMLElement>('.shelf-menu')!;
    const label = bar.querySelector<HTMLElement>('.shelf-menu-label')!;
    const items = [...menu.querySelectorAll<HTMLElement>('button[role="menuitemradio"]')];
    const sections = [...shelf.querySelectorAll<HTMLElement>('section[data-status]')];

    const VIEW_NAME: Record<string, string> = { grid: '网格', list: '列表' };
    const STATUS_NAME: Record<string, string> = {
      all: '全部',
      reading: '在读',
      read: '读完',
      want: '想读',
    };

    const KEY = 'hoshiki:books-view';
    const state = { status: 'all', view: 'grid' };
    try {
      Object.assign(state, JSON.parse(localStorage.getItem(KEY) || '{}'));
    } catch {}
    // 所选状态若已无书（书单变动），回退「全部」
    if (state.status !== 'all' && !items.some((b) => b.dataset.status === state.status)) {
      state.status = 'all';
    }

    function apply() {
      shelf.classList.toggle('is-list', state.view === 'list');
      for (const sec of sections) {
        sec.hidden = state.status !== 'all' && sec.dataset.status !== state.status;
      }
      for (const b of items) {
        const on = b.dataset.view === state.view || b.dataset.status === state.status;
        b.setAttribute('aria-checked', String(on));
      }
      label.textContent = `${VIEW_NAME[state.view]} · ${STATUS_NAME[state.status]}`;
    }

    function openMenu() {
      menu.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
    }
    function closeMenu() {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    }

    toggle.addEventListener('click', () => {
      menu.hidden ? openMenu() : closeMenu();
    });
    menu.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('button');
      if (!btn) return;
      if (btn.dataset.view) state.view = btn.dataset.view;
      if (btn.dataset.status) state.status = btn.dataset.status;
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch {}
      apply();
    });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !bar.contains(e.target as Node)) closeMenu();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        closeMenu();
        toggle.focus();
      }
    });

    apply();
  }
</script>

<style is:global>
  /* Readwise 风：暖白底、珊瑚橙强调色、无衬线、更圆的角 —— 只在书林页生效 */
  body.readwise-books {
    --c-canvas: #ffffff;
    --c-surface: #fbfbfa;
    --c-line: #ececea;
    --c-accent: #ff5a36;
    --c-accent-weak: #ffe9e2;
    --shadow-float: 0 4px 20px rgba(20, 20, 20, 0.08);
    --radius: 16px;
    --radius-sm: 10px;
    --font-serif-latin: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto;
    --font-serif-cjk: 'PingFang SC', 'Microsoft YaHei', 'Helvetica Neue', sans-serif;
  }
  body.readwise-books .site-header {
    background: var(--c-canvas);
  }
</style>

<style>
  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }
  .src {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--c-accent);
    color: #fff;
    text-decoration: none;
    font-size: 0.95em;
  }
  .src:hover {
    background: var(--c-ink);
  }

  .shelf-bar {
    display: flex;
    justify-content: flex-end;
  }
  .shelf-menu-wrap {
    position: relative;
  }
  .shelf-menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-sm);
    color: var(--c-ink-soft);
    font-family: inherit;
    font-size: var(--fs-small);
    cursor: pointer;
  }
  .shelf-menu-toggle:hover {
    border-color: var(--c-accent);
  }

  .shelf-menu {
    position: absolute;
    right: 0;
    top: calc(100% + var(--s-2));
    z-index: 10;
    min-width: 9rem;
    padding: var(--s-2);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-float);
  }
  .shelf-menu__group {
    margin: var(--s-2) var(--s-2) var(--s-1);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    color: var(--c-ink-faint);
  }
  .shelf-menu hr {
    margin: var(--s-2) 0;
    border: 0;
    border-top: 1px solid var(--c-line);
  }
  .shelf-menu button {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    width: 100%;
    padding: var(--s-2);
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--c-ink);
    font-family: inherit;
    font-size: var(--fs-small);
    text-align: left;
    cursor: pointer;
  }
  .shelf-menu button::before {
    content: '';
    width: 1em;
    flex-shrink: 0;
    color: var(--c-accent);
  }
  .shelf-menu button[aria-checked='true']::before {
    content: '✓';
  }
  .shelf-menu button:hover {
    background: var(--c-accent-weak);
  }
</style>
