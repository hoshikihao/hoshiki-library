---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookShelf from '../components/BookShelf.astro';
import { BOOK_BOT } from '../consts';
import xiaoshuAvatar from '../assets/xiaoshu-avatar.jpg';

const books = await getCollection('books');

const counts = { reading: 0, read: 0, want: 0 };
for (const b of books) counts[b.data.status]++;
---

<BaseLayout title="书籍" description="星树浩的书架：在读、读完、想读，每本一句话。">
  <div class="page page--wide stack">
    <header>
      <h1>书籍</h1>
      <p class="meta">在读 · 读完 · 想读，每本一句话</p>
    </header>

    <section class="resources">
      <p class="resources__lead">电子书按书名或作者搜，三个渠道：</p>

      <div class="resources__row">
        <a class="src" href="https://annas-archive.cc" target="_blank" rel="noopener">Anna's Archive</a>
        <a class="src" href="https://z-library.bz" target="_blank" rel="noopener">Z-Library</a>
        <span class="meta">聚合站，自己搜</span>
      </div>

      <div class="resources__row">
        <Image
          class="bot-avatar"
          src={xiaoshuAvatar}
          alt={`${BOOK_BOT.name}（Telegram bot）头像`}
          width={88}
          height={88}
          loading="lazy"
        />
        <a class="btn" href={BOOK_BOT.url} target="_blank" rel="noopener">
          在 Telegram 找{BOOK_BOT.name} ↗
        </a>
        <span class="meta">找不到的发给它，从我的库里找</span>
      </div>
    </section>

    <div class="shelf-controls" hidden>
      <div class="seg" role="group" aria-label="阅读状态">
        <button type="button" data-status="all" aria-pressed="true">全部</button>
        {counts.reading > 0 && <button type="button" data-status="reading">在读</button>}
        {counts.read > 0 && <button type="button" data-status="read">读完</button>}
        {counts.want > 0 && <button type="button" data-status="want">想读</button>}
      </div>
      <div class="seg" role="group" aria-label="排列方式">
        <button type="button" data-view="grid" aria-pressed="true">网格</button>
        <button type="button" data-view="list">列表</button>
      </div>
    </div>

    <div data-pagefind-body>
      <BookShelf books={books} />
    </div>
  </div>
</BaseLayout>

<script>
  const controls = document.querySelector<HTMLElement>('.shelf-controls');
  const shelf = document.querySelector<HTMLElement>('[data-shelf]');
  if (controls && shelf) {
    controls.hidden = false;
    const KEY = 'hoshiki:books-view';
    const state = { status: 'all', view: 'grid' };
    try {
      Object.assign(state, JSON.parse(localStorage.getItem(KEY) || '{}'));
    } catch {}

    const sections = [...shelf.querySelectorAll<HTMLElement>('section[data-status]')];
    const statusBtns = [...controls.querySelectorAll<HTMLElement>('[data-status]')];
    const viewBtns = [...controls.querySelectorAll<HTMLElement>('[data-view]')];

    // 所选状态若已无书（例如书单变动），回退到「全部」
    if (state.status !== 'all' && !statusBtns.some((b) => b.dataset.status === state.status)) {
      state.status = 'all';
    }

    function apply() {
      shelf.classList.toggle('is-list', state.view === 'list');
      for (const sec of sections) {
        sec.hidden = state.status !== 'all' && sec.dataset.status !== state.status;
      }
      for (const b of statusBtns) {
        b.setAttribute('aria-pressed', String(b.dataset.status === state.status));
      }
      for (const b of viewBtns) {
        b.setAttribute('aria-pressed', String(b.dataset.view === state.view));
      }
    }

    controls.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('button');
      if (!btn) return;
      if (btn.dataset.status) state.status = btn.dataset.status;
      if (btn.dataset.view) state.view = btn.dataset.view;
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch {}
      apply();
    });

    apply();
  }
</script>

<style>
  .resources {
    padding: var(--s-6);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .resources__lead {
    margin: 0;
    color: var(--c-ink-soft);
  }
  .resources__row {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
  .src {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--c-accent);
    color: #fff;
    text-decoration: none;
    font-size: 0.95em;
  }
  .src:hover {
    background: var(--c-ink);
  }
  .bot-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--c-line);
    flex-shrink: 0;
  }

  .shelf-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    justify-content: space-between;
  }
  .seg {
    display: inline-flex;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .seg button {
    appearance: none;
    border: 0;
    border-left: 1px solid var(--c-line);
    background: var(--c-surface);
    color: var(--c-ink-soft);
    font-family: inherit;
    font-size: var(--fs-small);
    padding: var(--s-2) var(--s-4);
    cursor: pointer;
  }
  .seg button:first-child {
    border-left: 0;
  }
  .seg button[aria-pressed='true'] {
    background: var(--c-accent);
    color: #fff;
  }
</style>
