---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import FilmShelf from '../components/FilmShelf.astro';

const films = await getCollection('films');

const counts = { anime: 0, series: 0, movie: 0, doc: 0 };
for (const f of films) counts[f.data.type]++;
---

<BaseLayout title="光影" description="星树浩的观影记录：动漫、剧集、电影、纪录片，每部一句话。" bodyClass="bilibili-films">
  <div class="page page--wide stack">
    <header>
      <h1>光影</h1>
      <div class="platforms">
        <a class="src" href="https://www.netflix.com" target="_blank" rel="noopener">
          <Icon name="simple-icons:netflix" width={15} height={15} />
          Netflix
        </a>
        <a class="src" href="https://tv.apple.com" target="_blank" rel="noopener">
          <Icon name="simple-icons:appletv" width={15} height={15} />
          Apple TV
        </a>
        <a class="src" href="https://www.youtube.com" target="_blank" rel="noopener">
          <Icon name="simple-icons:youtube" width={16} height={16} />
          YouTube
        </a>
        <a class="src" href="https://www.bilibili.com" target="_blank" rel="noopener">
          <Icon name="simple-icons:bilibili" width={16} height={16} />
          B 站
        </a>
      </div>
    </header>

    <div class="shelf-bar" hidden>
      <div class="shelf-menu-wrap">
        <button
          type="button"
          class="shelf-menu-toggle"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <Icon name="lucide:sliders-horizontal" width={14} height={14} />
          <span class="shelf-menu-label">网格 · 全部</span>
        </button>
        <div class="shelf-menu" role="menu" hidden>
          <p class="shelf-menu__group">排列</p>
          <button type="button" role="menuitemradio" data-view="grid" aria-checked="true">网格</button>
          <button type="button" role="menuitemradio" data-view="list" aria-checked="false">列表</button>
          <hr />
          <p class="shelf-menu__group">类型</p>
          <button type="button" role="menuitemradio" data-type="all" aria-checked="true">全部</button>
          {counts.anime > 0 && <button type="button" role="menuitemradio" data-type="anime" aria-checked="false">动漫</button>}
          {counts.series > 0 && <button type="button" role="menuitemradio" data-type="series" aria-checked="false">剧集</button>}
          {counts.movie > 0 && <button type="button" role="menuitemradio" data-type="movie" aria-checked="false">电影</button>}
          {counts.doc > 0 && <button type="button" role="menuitemradio" data-type="doc" aria-checked="false">纪录片</button>}
        </div>
      </div>
    </div>

    <div data-pagefind-body>
      <FilmShelf films={films} />
    </div>
  </div>
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>('.shelf-bar');
  const shelf = document.querySelector<HTMLElement>('[data-shelf]');
  if (bar && shelf) {
    bar.hidden = false;

    const toggle = bar.querySelector<HTMLElement>('.shelf-menu-toggle')!;
    const menu = bar.querySelector<HTMLElement>('.shelf-menu')!;
    const label = bar.querySelector<HTMLElement>('.shelf-menu-label')!;
    const items = [...menu.querySelectorAll<HTMLElement>('button[role="menuitemradio"]')];
    const sections = [...shelf.querySelectorAll<HTMLElement>('section[data-type]')];

    const VIEW_NAME: Record<string, string> = { grid: '网格', list: '列表' };
    const TYPE_NAME: Record<string, string> = {
      all: '全部',
      anime: '动漫',
      series: '剧集',
      movie: '电影',
      doc: '纪录片',
    };

    const KEY = 'hoshiki:films-view';
    const state = { type: 'all', view: 'grid' };
    try {
      Object.assign(state, JSON.parse(localStorage.getItem(KEY) || '{}'));
    } catch {}
    // 所选类型若已无片（片单变动），回退「全部」
    if (state.type !== 'all' && !items.some((b) => b.dataset.type === state.type)) {
      state.type = 'all';
    }

    function apply() {
      shelf.classList.toggle('is-list', state.view === 'list');
      for (const sec of sections) {
        sec.hidden = state.type !== 'all' && sec.dataset.type !== state.type;
      }
      for (const b of items) {
        const on = b.dataset.view === state.view || b.dataset.type === state.type;
        b.setAttribute('aria-checked', String(on));
      }
      label.textContent = `${VIEW_NAME[state.view]} · ${TYPE_NAME[state.type]}`;
    }

    function openMenu() {
      menu.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
    }
    function closeMenu() {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    }

    toggle.addEventListener('click', () => {
      menu.hidden ? openMenu() : closeMenu();
    });
    menu.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('button');
      if (!btn) return;
      if (btn.dataset.view) state.view = btn.dataset.view;
      if (btn.dataset.type) state.type = btn.dataset.type;
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch {}
      apply();
    });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !bar.contains(e.target as Node)) closeMenu();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        closeMenu();
        toggle.focus();
      }
    });

    apply();
  }
</script>

<style is:global>
  /* bilibili 风：白底、粉色强调、圆润卡片 —— 只在光影页生效 */
  body.bilibili-films {
    --c-canvas: #ffffff;
    --c-surface: #ffffff;
    --c-sand: #f1f2f3;
    --c-line: #e3e5e7;
    --c-ink: #18191c;
    --c-ink-soft: #61666d;
    --c-ink-faint: #9499a0;
    --c-accent: #fb7299;
    --c-accent-weak: #fff0f5;
    --shadow-float: 0 4px 16px rgba(251, 114, 153, 0.18);
    --font-serif-latin: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto;
    --font-serif-cjk: 'PingFang SC', 'Microsoft YaHei', 'Helvetica Neue', sans-serif;
  }
  body.bilibili-films .site-header {
    background: var(--c-canvas);
  }
</style>

<style>
  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }
  .src {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px 4px 10px;
    border-radius: 999px;
    background: var(--c-accent-weak);
    border: 1px solid transparent;
    color: var(--c-accent);
    text-decoration: none;
    font-size: 0.95em;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .src:hover {
    background: var(--c-accent);
    color: #fff;
  }

  .shelf-bar {
    display: flex;
    justify-content: flex-end;
  }
  .shelf-menu-wrap {
    position: relative;
  }
  .shelf-menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-sm);
    color: var(--c-ink-soft);
    font-family: inherit;
    font-size: var(--fs-small);
    cursor: pointer;
  }
  .shelf-menu-toggle:hover {
    border-color: var(--c-accent);
  }

  .shelf-menu {
    position: absolute;
    right: 0;
    top: calc(100% + var(--s-2));
    z-index: 10;
    min-width: 9rem;
    padding: var(--s-2);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-float);
  }
  .shelf-menu__group {
    margin: var(--s-2) var(--s-2) var(--s-1);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    color: var(--c-ink-faint);
  }
  .shelf-menu hr {
    margin: var(--s-2) 0;
    border: 0;
    border-top: 1px solid var(--c-line);
  }
  .shelf-menu button {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    width: 100%;
    padding: var(--s-2);
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--c-ink);
    font-family: inherit;
    font-size: var(--fs-small);
    text-align: left;
    cursor: pointer;
  }
  .shelf-menu button::before {
    content: '';
    width: 1em;
    flex-shrink: 0;
    color: var(--c-accent);
  }
  .shelf-menu button[aria-checked='true']::before {
    content: '✓';
  }
  .shelf-menu button:hover {
    background: var(--c-accent-weak);
  }
</style>
