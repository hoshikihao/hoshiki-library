---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTagBuckets } from '../../lib/tags';

const buckets = await getTagBuckets();
---

<BaseLayout title="标签" description="按主题浏览全部文章标签。">
  <div class="page stack">
    <header>
      <h1>标签</h1>
      <p class="meta">共 {buckets.length} 个标签</p>
    </header>

    <ul class="tag-cloud">
      {
        buckets.map((b) => (
          <li data-tag={b.tag}>
            <a class="tag" href={`/tags/${encodeURIComponent(b.tag)}`}>
              {b.tag} <span class="tag-cloud__n">{b.total}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .tag-cloud {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .tag-cloud .tag {
    font-size: var(--fs-small);
  }
  .tag-cloud__n {
    color: var(--c-ink-faint);
  }
</style>
