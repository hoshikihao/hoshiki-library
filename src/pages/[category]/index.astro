---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { CATEGORIES, CATEGORY_MAP, type CategoryId } from '../../consts';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.id } }));
}

const { category } = Astro.params as { category: CategoryId };
const meta = CATEGORY_MAP[category];

const articles = (await getCollection('articles', (e) => !e.data.draft))
  .filter((e) => e.data.category === category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={meta.name} description={`${meta.name}（${meta.blurb}）— ${CATEGORIES.length} 个栏目之一`}>
  <div class="page stack">
    <header>
      <h1>{meta.name}</h1>
      <p class="meta">{meta.blurb} · 共 {articles.length} 篇</p>
    </header>

    {
      articles.length === 0 ? (
        <p class="meta">还没有收录文章。</p>
      ) : (
        <div>
          {articles.map((e) => (
            <ArticleCard id={e.id} data={e.data} body={e.body ?? ''} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
