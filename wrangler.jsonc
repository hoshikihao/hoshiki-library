{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoshiki-library",
  "compatibility_date": "2026-09-04",
  // 纯静态：把 dist 作为静态资源托管，无 Worker 代码。
  // 以后要 SSR / API：安装 @astrojs/cloudflare，加 "main" 指向 Worker 入口即可。
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
